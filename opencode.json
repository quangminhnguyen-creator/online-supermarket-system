{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "instructions": [
    "AGENTS.md",
    ".ai/WORKFLOW.md"
  ],
  "enabled_providers": [
    "9router"
  ],
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router (local semantic routes)",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:NINE_ROUTER_API_KEY}"
      },
      "models": {
        "plan": {
          "id": "workflow-plan",
          "name": "Planning route"
        },
        "action": {
          "id": "workflow-action",
          "name": "Implementation route"
        },
        "review": {
          "id": "workflow-review",
          "name": "Review route"
        },
        "docs": {
          "id": "workflow-docs",
          "name": "Documentation route"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow"
    },
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".worktrees/**",
      ".codegraph/**",
      "**/bin/**",
      "**/obj/**",
      "**/node_modules/**",
      "**/dist/**"
    ]
  }
}
